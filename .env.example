PORT=3000
# Gunakan host eksplisit + tls=true agar tidak bergantung query DNS TXT Atlas.
MONGODB_URI=mongodb://USERNAME:PASSWORD@host-00.cluster.xxxxx.mongodb.net:27017,host-01.cluster.xxxxx.mongodb.net:27017/sprouty?authSource=admin&replicaSet=REPLICASET&retryWrites=true&w=majority&tls=true

# Kunci untuk ESP32 saat POST data sensor.
DEVICE_API_KEY=sprouty-device-secret-2026

# Set true kalau endpoint tanaman ingin diproteksi JWT.
REQUIRE_AUTH=false
JWT_SECRET=ganti-dengan-secret-panjang-dan-acak
